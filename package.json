{
	"name": "excalink-plugin",
	"version": "1.1.2",
	"description": "Suggests and links the named frames and groups inside your Excalidraw drawings when typing [[filename# in the editor.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"lint": "eslint .",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [
		"obsidian",
		"excalidraw",
		"frames",
		"groups",
		"autocomplete",
		"suggestions"
	],
	"author": "Aarambha",
	"license": "MIT",
	"devDependencies": {
		"@codemirror/state": "^6.5.2",
		"@codemirror/view": "^6.38.1",
		"@eslint/js": "^9.39.4",
		"@types/lz-string": "^1.3.34",
		"@types/node": "^22.15.17",
		"esbuild": "0.17.3",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"globals": "^17.6.0",
		"jiti": "^2.6.1",
		"obsidian": "latest",
		"tslib": "2.4.0",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.59.1"
	},
	"dependencies": {
		"lz-string": "^1.5.0"
	}
}
